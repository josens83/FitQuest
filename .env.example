# Database
DATABASE_URL="postgresql://user:password@localhost:5432/fitquest"
DIRECT_URL="postgresql://user:password@localhost:5432/fitquest"

# Supabase
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Authentication
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret"

# AI Services
ANTHROPIC_API_KEY="your-anthropic-api-key"
ELEVENLABS_API_KEY="your-elevenlabs-api-key"

# Payment
TOSS_CLIENT_KEY="your-toss-client-key"
TOSS_SECRET_KEY="your-toss-secret-key"
APPLE_IAP_SHARED_SECRET="your-apple-iap-secret"
GOOGLE_PLAY_SERVICE_ACCOUNT="your-google-play-service-account"

# Storage
CLOUDFLARE_R2_ACCESS_KEY="your-r2-access-key"
CLOUDFLARE_R2_SECRET_KEY="your-r2-secret-key"
CLOUDFLARE_R2_BUCKET="fitquest"
CLOUDFLARE_R2_ENDPOINT="your-r2-endpoint"

# Redis
UPSTASH_REDIS_URL="your-upstash-redis-url"
UPSTASH_REDIS_TOKEN="your-upstash-redis-token"

# Analytics
NEXT_PUBLIC_MIXPANEL_TOKEN="your-mixpanel-token"

# Push Notifications
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_PRIVATE_KEY="your-firebase-private-key"
FIREBASE_CLIENT_EMAIL="your-firebase-client-email"

# App URLs
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:4000"

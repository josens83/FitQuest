{
  "expo": {
    "name": "FitQuest",
    "slug": "fitquest",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "fitquest",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#6366F1"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fitquest.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "FitQuest needs camera access for food photo logging and profile pictures.",
        "NSPhotoLibraryUsageDescription": "FitQuest needs photo library access to select profile pictures and food photos.",
        "NSHealthShareUsageDescription": "FitQuest syncs with Health to track your workout metrics.",
        "NSHealthUpdateUsageDescription": "FitQuest writes workout data to Health for complete tracking."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#6366F1"
      },
      "package": "com.fitquest.app",
      "versionCode": 1,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.ACTIVITY_RECOGNITION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-av",
        {
          "microphonePermission": "Allow FitQuest to access your microphone for voice commands."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}

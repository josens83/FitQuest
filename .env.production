# FitQuest Production Environment
# IMPORTANT: This file should NOT be committed with real values
# Use secrets management (AWS Secrets Manager, HashiCorp Vault, etc.)

NODE_ENV=production
PORT=4000

# Database (use connection pooling in production)
DATABASE_URL=postgresql://fitquest:PRODUCTION_PASSWORD@prod-db.fitquest.com:5432/fitquest?schema=public&connection_limit=20

# Redis (use cluster in production)
REDIS_URL=redis://prod-redis.fitquest.com:6379

# JWT (use strong, unique secrets - minimum 64 characters recommended)
JWT_SECRET=production-jwt-secret-must-be-very-long-and-random-at-least-64-chars
JWT_REFRESH_SECRET=production-refresh-secret-must-be-very-long-and-random-64-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGINS=https://fitquest.com,https://www.fitquest.com

# Supabase
SUPABASE_URL=https://production-project.supabase.co
SUPABASE_ANON_KEY=production-anon-key
SUPABASE_SERVICE_KEY=production-service-key

# OpenAI
OPENAI_API_KEY=sk-production-key

# Stripe (Live Mode)
STRIPE_SECRET_KEY=sk_live_production
STRIPE_WEBHOOK_SECRET=whsec_production

# Sentry
SENTRY_DSN=https://production@sentry.io/fitquest

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Feature Flags
ENABLE_AI_COACH=true
ENABLE_PREMIUM_FEATURES=true
ENABLE_BETA_FEATURES=false
MAINTENANCE_MODE=false

# Rate Limiting (stricter in production)
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

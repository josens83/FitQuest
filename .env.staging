# FitQuest Staging Environment
# Copy this file and fill in the values

NODE_ENV=staging
PORT=4000

# Database
DATABASE_URL=postgresql://fitquest:STAGING_PASSWORD@staging-db.fitquest.com:5432/fitquest?schema=public

# Redis
REDIS_URL=redis://staging-redis.fitquest.com:6379

# JWT (use staging-specific secrets)
JWT_SECRET=staging-jwt-secret-minimum-32-characters
JWT_REFRESH_SECRET=staging-refresh-secret-minimum-32-chars
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGINS=https://staging.fitquest.com

# Supabase
SUPABASE_URL=https://staging-project.supabase.co
SUPABASE_ANON_KEY=staging-anon-key
SUPABASE_SERVICE_KEY=staging-service-key

# OpenAI
OPENAI_API_KEY=sk-staging-key

# Stripe (Test Mode)
STRIPE_SECRET_KEY=sk_test_staging
STRIPE_WEBHOOK_SECRET=whsec_staging

# Sentry
SENTRY_DSN=https://staging@sentry.io/fitquest

# Logging
LOG_LEVEL=debug
LOG_FORMAT=json

# Feature Flags
ENABLE_AI_COACH=true
ENABLE_PREMIUM_FEATURES=true
ENABLE_BETA_FEATURES=true
MAINTENANCE_MODE=false
